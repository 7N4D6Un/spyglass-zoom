{
  "schemaVersion": 1,
  "id": "spyzoom",
  "version": "${version}",

  "name": "Spyglass Zoom",
  "description": "A mod that lets you adjust the zoom on the spyglass.",
  "authors": ["FleTime", "guardian", "cobrasrock"],
  "contact": {
    "sources": "https://github.com/7N4D6Un/spyglass-zoom"
  },

  "license": "GNU-LGPL-3",
  "icon": "assets/spyzoom/icon.png",

  "environment": "client",
  "entrypoints": {
    "main": [
      "net.cobrasrock.spyzoom.SpyZoom"
    ]
  },
  "mixins": [
    "spyzoom.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.19.1",
    "minecraft": ">=26.1",
    "java": ">=25"
  }
}
